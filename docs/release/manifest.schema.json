{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market.osource.id/schemas/release-manifest-1.0.0.json",
  "title": "market.osource.id release manifest",
  "type": "object",
  "required": ["schema_version", "release", "artifacts", "evidence", "notes"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "release": {
      "type": "object",
      "required": ["version", "channel", "commit", "created_at"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 7 },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "platform", "path", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": [
              "backend-binary",
              "web-build",
              "container-image",
              "desktop-installer",
              "checksum-file",
              "sbom"
            ]
          },
          "platform": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "sbom": { "type": "string" },
          "labels": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "required": ["ci_workflow", "smoke_test_notes"],
      "properties": {
        "ci_workflow": { "type": "string", "minLength": 1 },
        "smoke_test_notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "object",
      "required": ["known_limitations", "rollback", "upgrade"],
      "properties": {
        "known_limitations": { "type": "string", "minLength": 1 },
        "rollback": { "type": "string", "minLength": 1 },
        "upgrade": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
